---
import type { Language } from '@/i18n/config'
import LanguageSwitcherIcon from '@/assets/icons/language-switcher.svg'
// import SearchIcon from '@/assets/icons/search-icon.svg' // search disabled for now
import ThemeToggleIcon from '@/assets/icons/theme-toggle.svg'
import { moreLocales, themeConfig } from '@/config'
import { getNextGlobalLangPath, getNextSupportedLangPath } from '@/i18n/path'
import { ui } from '@/i18n/ui'
import { getPageInfo } from '@/utils/page'

interface Props {
  supportedLangs: Language[]
}

const {
  light: { background: lightMode },
  dark: { background: darkMode },
} = themeConfig.color

const { supportedLangs } = Astro.props
const currentPath = Astro.url.pathname
const { currentLang } = getPageInfo(currentPath)
const currentUI = ui[currentLang as keyof typeof ui] ?? {}

// Check if there are other languages to switch
const showLanguageSwitcher = moreLocales.length > 0
// Choose a language switch list according to supported languages
const nextUrl = supportedLangs.length > 0
  ? getNextSupportedLangPath(currentPath, supportedLangs) // Use supported languages when available
  : getNextGlobalLangPath(currentPath) // Fallback to all languages when no supported languages data
---

<div
  class:list={[
  'absolute right-7.25vw top-14.6 flex gap-6 min-[823px]:max-lg:right-[calc(50vw-22rem)]',
  'lg:(fixed bottom-[min(10.27rem+1.92vw,12rem)] right-[max(5rem,calc(50vw-35rem))] top-auto w-14rem)',
]}
>
  {/* Search is disabled for now; uncomment to enable (also in Layout.astro and astro.config.ts).
  <button
    id="search-button"
    type="button"
    class="aspect-square w-4 c-secondary active:scale-90 hover:c-primary"
    aria-label={currentUI.search}
    aria-haspopup="dialog"
    aria-controls="search-dialog"
  >
    <SearchIcon
      aria-hidden="true"
      fill="currentColor"
    />
  </button>
  */}

  <!-- Language Switcher -->
  {showLanguageSwitcher && (
    <a
      id="language-switcher"
      href={nextUrl}
      class="aspect-square w-4 c-secondary active:scale-90 hover:c-primary"
      aria-label="Switch website language"
    >
      <LanguageSwitcherIcon
        aria-hidden="true"
        fill="currentColor"
      />
    </a>
  )}

  <!-- Theme Toggle -->
  <button
    id="theme-toggle-button"
    class="aspect-square w-4 c-secondary active:scale-90 hover:c-primary"
    data-light-mode={lightMode}
    data-dark-mode={darkMode}
    aria-label="Switch light/dark theme"
  >
    <ThemeToggleIcon
      aria-hidden="true"
      fill="currentColor"
    />
  </button>
</div>

<!-- Theme Toggle Script >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>> -->
<script>
type StoredTheme = 'dark' | 'light'

function getStoredTheme(): StoredTheme | null {
  const storedTheme = localStorage.getItem('theme')
  return storedTheme === 'dark' || storedTheme === 'light' ? storedTheme : null
}

// Apply theme changes
function applyTheme(isDark: boolean, options: { persist?: boolean } = {}) {
  document.documentElement.classList.toggle('dark', isDark)

  // Update meta theme-color tag
  const metaThemeColor = document.head.querySelector('meta[name="theme-color"]')
  const themeButton = document.getElementById('theme-toggle-button')
  const lightMode = themeButton?.dataset.lightMode
  const darkMode = themeButton?.dataset.darkMode

  if (metaThemeColor && lightMode && darkMode) {
    metaThemeColor.setAttribute('content', isDark ? darkMode : lightMode)
    document.documentElement.style.backgroundColor = isDark ? darkMode : lightMode
  }

  if (options.persist === true) {
    localStorage.setItem('theme', isDark ? 'dark' : 'light')
  }
  document.dispatchEvent(new Event('theme-changed'))
}

// Toggle theme mode
function toggleThemeFromUser() {
  const isDark = !document.documentElement.classList.contains('dark')
  applyTheme(isDark, { persist: true })
}

let activeThemeTransition: { finished: Promise<unknown> } | null = null

function clearThemeTransition(root: HTMLElement) {
  root.style.removeProperty('view-transition-name')
  root.style.removeProperty('--ink-x')
  root.style.removeProperty('--ink-y')
  root.style.removeProperty('--ink-size')
  root.removeAttribute('data-theme-changing')
  activeThemeTransition = null
}

// Handle theme toggle click events
function handleThemeToggle(e: MouseEvent) {
  if (!(e.target instanceof Element)) {
    return
  }

  const themeButton = e.target.closest('#theme-toggle-button')
  if (!(themeButton instanceof HTMLElement)) {
    return
  }

  const root = document.documentElement
  const supportsTransition = typeof document.startViewTransition === 'function'

  // If motion is reduced, the API is unavailable, or a transition is running,
  // keep the theme change immediate and deterministic.
  if (root.classList.contains('reduce-motion') || !supportsTransition) {
    toggleThemeFromUser()
    return
  }
  if (activeThemeTransition) {
    return
  }

  // The ink drop lands on the toggle itself (also when triggered by keyboard).
  const rect = themeButton.getBoundingClientRect()
  const x = rect.left + rect.width / 2
  const y = rect.top + rect.height / 2
  const farthest = Math.hypot(
    Math.max(x, window.innerWidth - x),
    Math.max(y, window.innerHeight - y),
  )
  // The blob's solid core is ~30% of its image, see transition.css.
  const inkSize = Math.ceil(farthest * 3.4)
  const goingDark = !root.classList.contains('dark')

  // Add temporary markers before view transition
  root.style.setProperty('view-transition-name', 'theme-toggle-transition')
  root.style.setProperty('--ink-x', `${x}px`)
  root.style.setProperty('--ink-y', `${y}px`)
  root.style.setProperty('--ink-size', `${inkSize}px`)
  root.setAttribute('data-theme-changing', goingDark ? 'to-dark' : 'to-light')

  // Use View Transitions API for theme toggle
  try {
    const transition = document.startViewTransition(toggleThemeFromUser)
    activeThemeTransition = transition

    // Remove temporary markers after view transition
    transition.finished.then(
      () => clearThemeTransition(root),
      () => clearThemeTransition(root),
    )
  }
  catch {
    clearThemeTransition(root)
    toggleThemeFromUser()
  }
}

// Listen to system theme changes in real time
function handleSystemChange(event: MediaQueryListEvent) {
  if (getStoredTheme() === null) {
    applyTheme(event.matches, { persist: false })
  }
}

document.addEventListener('click', handleThemeToggle)

// Language Switch >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
// The page is rewritten block by block, top to bottom: each visible block
// (a heading, a paragraph, a list entry...) of the old page lifts off in
// turn, then the new page's blocks are written in one after another.
// Every block gets its own view-transition-name so the browser can animate
// it separately; the count is capped so phones stay smooth.
const LANG_BLOCKS = [
  'header',
  'nav',
  '#post-date',
  '#post-content > *',
  '.post-list > li',
  'main :is(h1, h2, h3, h4, p, li, blockquote, pre, table, figure)',
  'footer',
].join(', ')
const LANG_MAX_BLOCKS = 14
const OLD_STAGGER = 0.015 // s between old blocks lifting off
const NEW_START = 0.3 // s, when the first new block starts writing
const NEW_STAGGER = 0.05 // s between new blocks

function pickBlocks(doc: Document, visibleOnly: boolean) {
  const picked: HTMLElement[] = []
  const chosen = new Set<Element>()

  for (const el of doc.querySelectorAll<HTMLElement>(LANG_BLOCKS)) {
    if (picked.length >= LANG_MAX_BLOCKS) {
      break
    }
    // Skip blocks nested in an already chosen block, and anything that
    // already carries its own transition name.
    let parent = el.parentElement
    let nested = false
    while (parent) {
      if (chosen.has(parent)) {
        nested = true
        break
      }
      parent = parent.parentElement
    }
    if (nested) {
      continue
    }
    if (visibleOnly) {
      const r = el.getBoundingClientRect()
      if (r.height === 0 || r.bottom < 0 || r.top > window.innerHeight) {
        continue
      }
    }
    chosen.add(el)
    picked.push(el)
    // Shared-element names inside a block would pull that piece out of its
    // block; across languages they never match anyway, so mute them.
    for (const inner of el.querySelectorAll<HTMLElement>('[data-astro-transition-scope]')) {
      inner.style.setProperty('view-transition-name', 'none')
    }
  }

  if (visibleOnly) {
    picked.sort((a, b) => a.getBoundingClientRect().top - b.getBoundingClientRect().top)
  }
  return picked
}

let languageSwitchPending = false
let oldBlockCount = 0

// Before the browser captures the old page: name its visible blocks.
document.addEventListener('astro:before-preparation', (e) => {
  oldBlockCount = 0
  languageSwitchPending = e.sourceElement instanceof Element
    && e.sourceElement.closest('#language-switcher') !== null
    && !document.documentElement.classList.contains('reduce-motion')
  if (!languageSwitchPending) {
    return
  }
  const blocks = pickBlocks(document, true)
  blocks.forEach((el, i) => {
    el.style.setProperty('view-transition-name', `lang-o-${i}`)
  })
  oldBlockCount = blocks.length
})

// Before the new page replaces the old one: name its first blocks, stamp it,
// and give every block its own delay.
document.addEventListener('astro:before-swap', (e) => {
  if (!languageSwitchPending) {
    return
  }
  languageSwitchPending = false

  const doc = e.newDocument
  doc.documentElement.setAttribute('data-lang-arrived', '')

  const blocks = pickBlocks(doc, false)
  blocks.forEach((el, i) => {
    el.style.setProperty('view-transition-name', `lang-n-${i}`)
  })

  const rules: string[] = []
  for (let i = 0; i < oldBlockCount; i++) {
    rules.push(`html[data-lang-arrived]:not([data-theme-changing])::view-transition-old(lang-o-${i}){animation-delay:${(i * OLD_STAGGER).toFixed(3)}s!important}`)
  }
  blocks.forEach((_, i) => {
    rules.push(`html[data-lang-arrived]:not([data-theme-changing])::view-transition-new(lang-n-${i}){animation-delay:${(NEW_START + i * NEW_STAGGER).toFixed(3)}s!important}`)
  })
  const style = doc.createElement('style')
  style.id = 'lang-switch-timing'
  style.textContent = rules.join('\n')
  doc.head.append(style)

  // Once the rewrite has played, drop the temporary names so they never
  // affect later transitions (theme toggle, next navigation).
  const release = () => {
    for (const el of document.querySelectorAll<HTMLElement>('[style*="view-transition-name"]')) {
      el.style.removeProperty('view-transition-name')
    }
    document.getElementById('lang-switch-timing')?.remove()
  }
  e.viewTransition.finished.then(release, release)
})
window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', handleSystemChange)
</script>
