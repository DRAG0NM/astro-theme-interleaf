---
import { themeConfig } from '@/config'
import { ui } from '@/i18n/ui'
import { getPageInfo } from '@/utils/page'

const { currentLang } = getPageInfo(Astro.url.pathname)
const currentUI = ui[currentLang as keyof typeof ui] ?? {}
const base = themeConfig.site.base.endsWith('/')
  ? themeConfig.site.base
  : `${themeConfig.site.base}/`
---

<!--
  Full-page search on a blank sheet of paper. The index is built by Pagefind
  after `astro build` (see the `index-search` script); in `astro dev` it does
  not exist yet, so the dialog simply reports no results.
-->
<dialog
  id="search-dialog"
  aria-label={currentUI.search}
  data-pagefind-base={base}
  data-empty={currentUI.searchEmpty}
>
  <div class="search-sheet">
    <div class="search-field">
      <input
        id="search-input"
        type="search"
        autocomplete="off"
        spellcheck="false"
        placeholder={currentUI.searchPlaceholder}
        aria-label={currentUI.search}
        aria-controls="search-results"
      />
      <button type="button" class="search-close" aria-label="Close">
        <kbd class="search-close-key" aria-hidden="true">Esc</kbd>
        <span class="search-close-cross" aria-hidden="true"></span>
      </button>
    </div>
    <p id="search-status" class="search-status" aria-live="polite"></p>
    <ol id="search-results" class="search-results"></ol>
  </div>
</dialog>


<script>
type PagefindResultData = {
  url: string
  excerpt: string
  meta: { title?: string }
}
type PagefindModule = {
  options: (opts: Record<string, unknown>) => Promise<void>
  init: () => Promise<void>
  debouncedSearch: (q: string, opts?: object, ms?: number) => Promise<{
    results: { data: () => Promise<PagefindResultData> }[]
  } | null>
}

let pagefind: PagefindModule | null = null
let pagefindFailed = false

async function loadPagefind(base: string) {
  if (pagefind || pagefindFailed) {
    return pagefind
  }
  try {
    const url = `${base}pagefind/pagefind.js`
    pagefind = await import(/* @vite-ignore */ url) as PagefindModule
    await pagefind.options({ excerptLength: 28 })
    await pagefind.init()
  }
  catch {
    pagefindFailed = true
    pagefind = null
  }
  return pagefind
}

function getEls() {
  const dialog = document.getElementById('search-dialog')
  const input = document.getElementById('search-input')
  const results = document.getElementById('search-results')
  const status = document.getElementById('search-status')
  if (!(dialog instanceof HTMLDialogElement) || !(input instanceof HTMLInputElement)
    || !(results instanceof HTMLOListElement) || !status) {
    return null
  }
  return { dialog, input, results, status }
}

function openSearch() {
  const els = getEls()
  if (!els || els.dialog.open) {
    return
  }
  els.dialog.showModal()
  els.input.select()
  void loadPagefind(els.dialog.dataset.pagefindBase ?? '/')
}

function closeSearch() {
  getEls()?.dialog.close()
}

async function runSearch() {
  const els = getEls()
  if (!els) {
    return
  }
  const { dialog, input, results, status } = els
  const query = input.value.trim()

  if (!query) {
    results.replaceChildren()
    status.textContent = ''
    return
  }

  const pf = await loadPagefind(dialog.dataset.pagefindBase ?? '/')
  const search = pf ? await pf.debouncedSearch(query, {}, 180) : { results: [] }
  if (search === null || input.value.trim() !== query) {
    return // superseded by a newer keystroke
  }

  const items = await Promise.all(search.results.slice(0, 8).map(r => r.data()))
  const fragment = document.createDocumentFragment()

  items.forEach((item, i) => {
    const li = document.createElement('li')
    li.style.setProperty('--i', String(i))

    const a = document.createElement('a')
    a.href = item.url

    const title = document.createElement('div')
    title.className = 'search-result-title'
    title.textContent = item.meta.title ?? item.url

    // Pagefind excerpts come from this site's own posts and only carry <mark>.
    const excerpt = document.createElement('p')
    excerpt.className = 'search-result-excerpt'
    excerpt.innerHTML = item.excerpt

    a.append(title, excerpt)
    li.append(a)
    fragment.append(li)
  })

  results.replaceChildren(fragment)
  status.textContent = items.length === 0 ? (dialog.dataset.empty ?? '') : ''
}

document.addEventListener('click', (e) => {
  if (!(e.target instanceof Element)) {
    return
  }
  if (e.target.closest('#search-button')) {
    openSearch()
    return
  }
  // Clicking the blank paper (outside the field and results) closes it.
  const dialog = e.target.closest('#search-dialog')
  if (e.target.closest('.search-close')
    || (dialog && !e.target.closest('.search-field, .search-results a'))) {
    closeSearch()
  }
  // Following a result: close first so the page transition starts clean.
  if (e.target.closest('.search-results a')) {
    closeSearch()
  }
})

document.addEventListener('input', (e) => {
  if (e.target instanceof HTMLElement && e.target.id === 'search-input') {
    void runSearch()
  }
})

document.addEventListener('keydown', (e) => {
  const target = e.target as HTMLElement | null
  const typing = target?.closest('input, textarea, select, [contenteditable="true"]')

  if ((e.key === 'k' && (e.metaKey || e.ctrlKey)) || (e.key === '/' && !typing)) {
    e.preventDefault()
    openSearch()
  }
})
</script>
